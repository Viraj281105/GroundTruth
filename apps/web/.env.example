# ---------------------------------------------------------------------------
# GroundTruth web app. Copy to apps/web/.env.local: Next.js reads env files from
# this folder, not from the repository root.
#
# NEXT_PUBLIC_* values are inlined into the JavaScript at BUILD time
# (`npm run build`). Changing them on a running server does nothing; a build for
# a deployed API must be made with that API's URL set.
# ---------------------------------------------------------------------------

# Where the browser calls the API. The page's origin must also be listed in the
# API's CORS_ALLOWED_ORIGINS (or be its FRONTEND_URL), or every call fails in the
# browser as if the API were down.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Off by default. When true, an unreachable backend may serve synthetic fixture
# data, always under the non-dismissible "no analysis was executed" banner. When
# false, an unreachable backend is a visible error, never a silent substitution.
NEXT_PUBLIC_DEMO_MODE=false

# Server-side only. The site's own public origin, sent as `Origin` on state-changing
# calls the Next server makes to the API (e.g. switching organization). It must equal
# the API's FRONTEND_URL (or be listed in CORS_ALLOWED_ORIGINS). Read in order:
# SITE_URL, NEXT_PUBLIC_SITE_URL, FRONTEND_URL; default http://localhost:3000.
SITE_URL=http://localhost:3000
