{
  "name": "groundtruth-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:api-types",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:fixture-fallback": "node scripts/check-fixture-fallback.js",
    "generate:api": "openapi-typescript src/lib/generated/openapi.json -o src/lib/generated/schema.d.ts --default-non-nullable=false",
    "check:api-types": "node scripts/check-api-types.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "maplibre-gl": "4.7.1",
    "next": "^14.2.24",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.24",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
