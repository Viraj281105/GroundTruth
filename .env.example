# ---------------------------------------------------------------------------
# GroundTruth configuration. Copy to .env and fill in what you need.
# Every external provider is optional: the full pipeline runs offline against
# the synthetic fixture with none of these set.
# Run `groundtruth doctor` to see what is configured.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# Seed for every stochastic step. Reproducibility is a requirement, not a
# convenience: two runs with the same seed must produce identical output.
RANDOM_SEED=20260101

# --- Earth observation -----------------------------------------------------
# Credentials for Google Earth Engine (`GEE_SERVICE_ACCOUNT_JSON`) and Sentinel Hub
# (`SENTINEL_HUB_CLIENT_ID`). Note: live end-to-end satellite reducer ingestion is
# NOT YET USED in the default runtime (see docs/10-roadmap.md milestone M1); all
# bundled demo cases execute against explicit SYNTHETIC fixtures (`data/synthetic_fixtures/`).
GOOGLE_CLOUD_PROJECT=
GEE_SERVICE_ACCOUNT_JSON=
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
GLOBAL_FOREST_WATCH_API_KEY=

# --- Generative reporting layer --------------------------------------------
# GENAI_PROVIDER: none | gemini | nugen | openai | anthropic
# `none` uses the deterministic renderer, which produces a complete report with
# no model and no network. Optional narration API keys (`GEMINI_API_KEY`,
# `ANTHROPIC_API_KEY`) enable live LLM synthesis with automatic fallback to the
# deterministic renderer if unavailable or rate-limited.
# Supported LLM providers:
# - gemini: Google Gemini (gemini-2.5-flash / gemini-1.5-pro)
# - anthropic: Claude (claude-3-5-sonnet)
# Every emitted number is mathematically grounded against the EvidenceBundle.
GENAI_PROVIDER=none
GENAI_MODEL=gemini-2.5-flash
GENAI_BASE_URL=
GENAI_TEMPERATURE=0.0
GENAI_MAX_OUTPUT_TOKENS=1200
GEMINI_API_KEY=
NUGEN_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Persistence and services ----------------------------------------------
# Needed by the worker and by `groundtruth submit` / `job` (and the `db` extra).
# Background job leasing uses Postgres (`FOR UPDATE SKIP LOCKED`) by default via
# `DATABASE_URL`; `REDIS_URL` is optional and not required by the default worker.
# With `DATABASE_URL` unset, the worker refuses to run rather than create a
# local file. The API's /jobs and /runs endpoints answer 503 store_not_configured
# without it; /verify still runs inline.
# e.g. postgresql+psycopg://user:password@host/dbname
#      sqlite:///data/interim/groundtruth.db   (local; data/interim/ is gitignored)
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call the API, comma-separated, exact scheme+host+port.
# Unset means FRONTEND_URL alone. "*" is refused at startup.
# e.g. CORS_ALLOWED_ORIGINS=https://groundtruth.example.org,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# --- Authentication (docs/security/auth.md) ---------------------------------
# Single-tenant RBAC deployment model (`user`, `dev`, `admin` roles within a shared
# workspace). Require sign-in to run analyses and use the claims workbench (code default: false).
AUTH_REQUIRED=true
# Set true when served over HTTPS (adds Secure to the session cookie).
AUTH_COOKIE_SECURE=false
# false closes self-registration; the first account registered is always admin.
AUTH_ALLOW_REGISTRATION=true

# --- Build identity --------------------------------------------------------
# Commit this process runs, recorded on every result. Unset is recorded as null,
# never a placeholder. e.g. GIT_SHA=<output of: git rev-parse HEAD>
GIT_SHA=

# --- Analysis defaults -----------------------------------------------------
# Minimum admissible donors. Below this the pipeline refuses to estimate rather
# than producing an under-powered number.
MIN_DONORS=10
MIN_PRE_PERIODS=5
MAX_PRE_RMSE_RATIO=0.30

# --- Frontend (apps/web) ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Off by default. When true, an unreachable backend may serve synthetic
# fixture data in the UI, always flagged with a non-dismissible "no analysis
# was executed" banner. When false, an unreachable backend is a visible error,
# never a silent fixture substitution. See issue #58.
NEXT_PUBLIC_DEMO_MODE=false
